MODE=PAPER

POLYMARKET_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

STARTING_BANKROLL=1.00
TARGET_BANKROLL=3300000

RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.15
MAX_OPEN_EXPOSURE=0.25

MIN_EDGE=0.05
MIN_LIQUIDITY=100
POLL_SECONDS=10

# PHASE 1 SAFETY INVARIANT:
# Live order execution is hard-locked in code.
LIVE_TRADING_ENABLED=false

DB_PATH=data/friday.db

# ------------------------------------------------------------
# PHASE 3D — HERMES OPERATOR LAYER
# Hermes schedules and routes work. It has NO execution authority.
# ------------------------------------------------------------
# Start Hermes automatically with FRIDAY (true/false)
HERMES_AUTOSTART=true
# Hard daily ceiling on Claude tokens (input+output), per UTC day.
# ~6,000 tokens per analysis -> 250000 is roughly 40 analyses/day.
HERMES_DAILY_TOKEN_BUDGET=250000
# Recurring health check (seconds, minimum 30; 0 disables)
HERMES_HEALTH_INTERVAL_SECONDS=60
# Recurring read-only market scan (seconds, minimum 300; 0 disables)
HERMES_MARKET_SCAN_INTERVAL_SECONDS=900
HERMES_MARKET_SCAN_LIMIT=100
# Per-job timeout (seconds, minimum 10)
HERMES_JOB_TIMEOUT_SECONDS=120

# ------------------------------------------------------------
# PHASE 4 — KNOWLEDGE VAULT (separate private repo)
# ------------------------------------------------------------
FRIDAY_VAULT_PATH=~/friday/FRIDAY-Knowledge-Vault
# Phase 4B: FRIDAY writes analysis notes, a daily journal and market
# snapshots into FRIDAY/ of the vault (human folders are never written).
# true/false. If the vault is missing, FRIDAY runs normally without notes.
FRIDAY_KNOWLEDGE_ENABLED=true
# Minimum seconds between market-snapshot notes (minimum 300)
FRIDAY_SNAPSHOT_INTERVAL_SECONDS=3600
# Phase 4C: give Claude the Constitution, Risk Doctrine and related notes
# from YOUR folders as untrusted reference data (never instructions).
FRIDAY_KNOWLEDGE_RECALL=true
# Auto-commit FRIDAY/ notes in the vault's git repo (seconds; minimum 300,
# 0 disables). Only FRIDAY/ is ever committed.
FRIDAY_VAULT_SYNC_INTERVAL_SECONDS=900
# Push those commits to GitHub (fast-forward only, never forced). Set true
# only after the vault deploy key is set up and a manual push has worked.
FRIDAY_VAULT_PUSH=false
FRIDAY_VAULT_BRANCH=main

# ------------------------------------------------------------
# PHASE 5 — RESEARCH LIBRARY (server only, never in Git)
# ------------------------------------------------------------
# Private store + full-text index of your books, papers, notes and
# articles. Must be OUTSIDE any Git repository (FRIDAY refuses otherwise).
FRIDAY_LIBRARY_PATH=~/friday/library
# Phase 5B: FRIDAY picks up files dropped into ~/friday/library/inbox/
# (inbox/paper, inbox/note, inbox/article set the kind; top level = book).
# Seconds between checks; minimum 300, 0 disables.
FRIDAY_RESEARCH_INBOX_INTERVAL_SECONDS=600
# Contact shown in the fetcher's User-Agent (sites like Wikipedia require
# one from automated clients). A URL or an address you are happy to share.
FRIDAY_FETCH_CONTACT=https://github.com/davidwrightitconsult-svg
# Phase 5C: cited library passages in every Claude analysis (true/false)
FRIDAY_RESEARCH_RECALL=true
# Separate daily Claude token budget for on-request digests ONLY
# (analysis keeps HERMES_DAILY_TOKEN_BUDGET). ~6-10k tokens per section.
FRIDAY_RESEARCH_DAILY_TOKEN_BUDGET=200000

# ------------------------------------------------------------
# PHASE 6 — MARKET DATA (read-only; server only, never in Git)
# ------------------------------------------------------------
# Every market scan is stored as history (snapshots + top-of-book).
FRIDAY_MARKET_STORE=true
FRIDAY_MARKET_DB=~/friday/data/market_data.db
FRIDAY_MARKET_RETENTION_DAYS=365
FRIDAY_MARKET_BOOK_RETENTION_DAYS=30
FRIDAY_MARKET_BOOK_LEVELS=5
# 6C: skip markets that are effectively decided (best bid >= NEAR_CERTAIN or
# best ask <= 1 - NEAR_CERTAIN) or whose end date passed > PAST_END_HOURS ago.
# Skipped markets are counted in the scan report; freed slots are refilled.
FRIDAY_MARKET_EXCLUDE_SETTLED=true
FRIDAY_MARKET_NEAR_CERTAIN=0.98
FRIDAY_MARKET_PAST_END_HOURS=24
# How far down Gamma's volume ranking to page when many markets are excluded
FRIDAY_MARKET_MAX_CANDIDATES=600
# 6C: give Claude FRIDAY's recorded order-book data for the market(s) a command is about
FRIDAY_MARKET_CONTEXT=true

# ------------------------------------------------------------
# PHASE 7 — QUANT CORE (reads the market store; no execution authority)
# ------------------------------------------------------------
# Tradable-universe gate: a market is eligible for strategy work only if every
# outcome has usable, fresh data and it is deep, tight and active enough.
FRIDAY_QUANT_MIN_DEPTH_USD=500
FRIDAY_QUANT_MAX_SPREAD=0.05
FRIDAY_QUANT_MIN_VOLUME_24H=1000
FRIDAY_QUANT_MIN_PRICE=0.03
FRIDAY_QUANT_MAX_PRICE=0.97
FRIDAY_QUANT_MAX_AGE_SECONDS=1800
# 7B: strategy signals after every market scan (hypotheses under test; no orders)
FRIDAY_QUANT_SIGNALS=true
# all | none | comma list of BOOK_IMBALANCE,MEAN_REVERSION,MOMENTUM,LONGSHOT_BIAS
FRIDAY_QUANT_STRATEGIES=all
# Keep observing markets that were eligible within this many hours (0 = off)
FRIDAY_MARKET_WATCHLIST_HOURS=48
FRIDAY_MARKET_WATCHLIST_MAX=50
# 7C: ask Polymarket (read-only, hourly, max 20 markets / 30s) whether signalled
# markets have resolved, so strategies are also scored held-to-resolution
FRIDAY_QUANT_RESOLUTIONS=true

# ------------------------------------------------------------
# PHASE 10 — RISK GOVERNOR (every proposed position must pass it; PAPER only)
# ------------------------------------------------------------
# Paper bankroll (USD, notional) and limits as fractions of current equity.
# Hard ceilings in code: position 10%, exposure 60%, drawdown 25%, daily loss 10%.
FRIDAY_RISK_BANKROLL=1000
FRIDAY_RISK_MAX_POSITION=0.02
FRIDAY_RISK_MAX_MARKET=0.04
FRIDAY_RISK_MAX_STRATEGY=0.15
FRIDAY_RISK_MAX_EXPOSURE=0.30
FRIDAY_RISK_MAX_POSITIONS=15
# no new positions today after losing this much of the day's starting equity
FRIDAY_RISK_DAILY_LOSS=0.03
# halt until the owner resumes after falling this far below peak equity
FRIDAY_RISK_MAX_DRAWDOWN=0.10
FRIDAY_RISK_MIN_STAKE=1
FRIDAY_RISK_DB=~/friday/data/risk.db

# ------------------------------------------------------------
# PHASE 8 — PROBABILITY & EDGE
# ------------------------------------------------------------
# 8A: build the calibration dataset (resolved markets + their prices 1h..7d
# before resolution) in the background, read-only; a batch every few hours
FRIDAY_CALIBRATION_BACKFILL=true
# 9B.2: minimum lifetime volume (USD) of a resolved market to enter the dataset. Raised from
# 1000: thinner markets have unreliable prices and would not pass FRIDAY's live liquidity rules.
FRIDAY_CALIBRATION_MIN_VOLUME=10000
# seconds between price-history requests during the backfill
FRIDAY_CALIBRATION_PACE_SECONDS=0.05
FRIDAY_CALIBRATION_BATCH=300
FRIDAY_CALIBRATION_INTERVAL_HOURS=3
# 8C.2 SCOPE: FRIDAY is not a sports betting system. Segments listed here are
# dropped from the scan, universe, signals, edges and the calibration backfill.
# Segments: sports, field (one outcome of a multi-candidate event), binary.
# "none" includes everything.
# 9B.2: "micro" = recurring five-minute markets ("Bitcoin Up or Down - 12:35PM-12:40PM ET").
FRIDAY_EXCLUDED_SEGMENTS=sports,micro
# 8B: fair value + edge vs the live ask (estimated, unvalidated; numbers only)
FRIDAY_EDGE_FEE=0.0
FRIDAY_EDGE_MIN=0.02
FRIDAY_EDGE_MIN_Z=2.0
FRIDAY_EDGE_KELLY_FRACTION=0.25
FRIDAY_EDGE_MAX_STAKE=0.02
# 8C: model-uncertainty floor ($/share) added to the edge's standard error, so
# a thick calibration bin cannot make an edge look near-certain (z 17 -> ~5)
FRIDAY_EDGE_MODEL_SE=0.01
# 8C: EDGE estimates are recorded as CALIBRATION_EDGE signals (once per market)
# and scored held to resolution; it is part of FRIDAY_QUANT_STRATEGIES=all

# PHASE 12 — PAPER TRADING ENGINE (paper money only; live trading stays locked)
# An entry needs one of FRIDAY's own recorded quotes this fresh, and a spread no wider than this.
FRIDAY_PAPER_MAX_QUOTE_AGE_MINUTES=15
FRIDAY_PAPER_MAX_SPREAD=0.05
# 12B forward test: the Bollinger fade placed as resting paper orders (false = off; it is then not listed in the gate)
FRIDAY_PAPER_BOLLINGER=true

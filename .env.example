MODE=PAPER

POLYMARKET_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

STARTING_BANKROLL=1.00
TARGET_BANKROLL=3300000

RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.15
MAX_OPEN_EXPOSURE=0.25

MIN_EDGE=0.05
MIN_LIQUIDITY=100
POLL_SECONDS=10

# PHASE 1 SAFETY INVARIANT:
# Live order execution is hard-locked in code.
LIVE_TRADING_ENABLED=false

DB_PATH=data/friday.db

# ------------------------------------------------------------
# PHASE 3D — HERMES OPERATOR LAYER
# Hermes schedules and routes work. It has NO execution authority.
# ------------------------------------------------------------
# Start Hermes automatically with FRIDAY (true/false)
HERMES_AUTOSTART=true
# Hard daily ceiling on Claude tokens (input+output), per UTC day.
# ~6,000 tokens per analysis -> 250000 is roughly 40 analyses/day.
HERMES_DAILY_TOKEN_BUDGET=250000
# Recurring health check (seconds, minimum 30; 0 disables)
HERMES_HEALTH_INTERVAL_SECONDS=60
# Recurring read-only market scan (seconds, minimum 300; 0 disables)
HERMES_MARKET_SCAN_INTERVAL_SECONDS=900
HERMES_MARKET_SCAN_LIMIT=100
# Per-job timeout (seconds, minimum 10)
HERMES_JOB_TIMEOUT_SECONDS=120

# ------------------------------------------------------------
# PHASE 4 — KNOWLEDGE VAULT (separate private repo)
# ------------------------------------------------------------
JARVIS_VAULT_PATH=~/friday/FRIDAY-Knowledge-Vault
# Phase 4B: FRIDAY writes analysis notes, a daily journal and market
# snapshots into FRIDAY/ of the vault (human folders are never written).
# true/false. If the vault is missing, FRIDAY runs normally without notes.
JARVIS_KNOWLEDGE_ENABLED=true
# Minimum seconds between market-snapshot notes (minimum 300)
JARVIS_SNAPSHOT_INTERVAL_SECONDS=3600
# Phase 4C: give Claude the Constitution, Risk Doctrine and related notes
# from YOUR folders as untrusted reference data (never instructions).
JARVIS_KNOWLEDGE_RECALL=true
# Auto-commit FRIDAY/ notes in the vault's git repo (seconds; minimum 300,
# 0 disables). Only FRIDAY/ is ever committed.
JARVIS_VAULT_SYNC_INTERVAL_SECONDS=900
# Push those commits to GitHub (fast-forward only, never forced). Set true
# only after the vault deploy key is set up and a manual push has worked.
JARVIS_VAULT_PUSH=false
JARVIS_VAULT_BRANCH=main

# ------------------------------------------------------------
# PHASE 5 — RESEARCH LIBRARY (server only, never in Git)
# ------------------------------------------------------------
# Private store + full-text index of your books, papers, notes and
# articles. Must be OUTSIDE any Git repository (FRIDAY refuses otherwise).
JARVIS_LIBRARY_PATH=~/friday/library
# Phase 5B: FRIDAY picks up files dropped into ~/friday/library/inbox/
# (inbox/paper, inbox/note, inbox/article set the kind; top level = book).
# Seconds between checks; minimum 300, 0 disables.
JARVIS_RESEARCH_INBOX_INTERVAL_SECONDS=600
# Contact shown in the fetcher's User-Agent (sites like Wikipedia require
# one from automated clients). A URL or an address you are happy to share.
JARVIS_FETCH_CONTACT=https://github.com/davidwrightitconsult-svg
# Phase 5C: cited library passages in every Claude analysis (true/false)
JARVIS_RESEARCH_RECALL=true
# Separate daily Claude token budget for on-request digests ONLY
# (analysis keeps HERMES_DAILY_TOKEN_BUDGET). ~6-10k tokens per section.
JARVIS_RESEARCH_DAILY_TOKEN_BUDGET=200000

# ------------------------------------------------------------
# PHASE 6 — MARKET DATA (read-only; server only, never in Git)
# ------------------------------------------------------------
# Every market scan is stored as history (snapshots + top-of-book).
JARVIS_MARKET_STORE=true
JARVIS_MARKET_DB=~/friday/data/market_data.db
JARVIS_MARKET_RETENTION_DAYS=365
JARVIS_MARKET_BOOK_RETENTION_DAYS=30
JARVIS_MARKET_BOOK_LEVELS=5
# 6C: skip markets that are effectively decided (best bid >= NEAR_CERTAIN or
# best ask <= 1 - NEAR_CERTAIN) or whose end date passed > PAST_END_HOURS ago.
# Skipped markets are counted in the scan report; freed slots are refilled.
JARVIS_MARKET_EXCLUDE_SETTLED=true
JARVIS_MARKET_NEAR_CERTAIN=0.98
JARVIS_MARKET_PAST_END_HOURS=24
# How far down Gamma's volume ranking to page when many markets are excluded
JARVIS_MARKET_MAX_CANDIDATES=600
# 6C: give Claude FRIDAY's recorded order-book data for the market(s) a command is about
JARVIS_MARKET_CONTEXT=true

# ------------------------------------------------------------
# PHASE 7 — QUANT CORE (reads the market store; no execution authority)
# ------------------------------------------------------------
# Tradable-universe gate: a market is eligible for strategy work only if every
# outcome has usable, fresh data and it is deep, tight and active enough.
JARVIS_QUANT_MIN_DEPTH_USD=500
JARVIS_QUANT_MAX_SPREAD=0.05
JARVIS_QUANT_MIN_VOLUME_24H=1000
JARVIS_QUANT_MIN_PRICE=0.03
JARVIS_QUANT_MAX_PRICE=0.97
JARVIS_QUANT_MAX_AGE_SECONDS=1800
# 7B: strategy signals after every market scan (hypotheses under test; no orders)
JARVIS_QUANT_SIGNALS=true
# all | none | comma list of BOOK_IMBALANCE,MEAN_REVERSION,MOMENTUM,LONGSHOT_BIAS
JARVIS_QUANT_STRATEGIES=all
# Keep observing markets that were eligible within this many hours (0 = off)
JARVIS_MARKET_WATCHLIST_HOURS=48
JARVIS_MARKET_WATCHLIST_MAX=50
# 7C: ask Polymarket (read-only, hourly, max 20 markets / 30s) whether signalled
# markets have resolved, so strategies are also scored held-to-resolution
JARVIS_QUANT_RESOLUTIONS=true

# ------------------------------------------------------------
# PHASE 10 — RISK GOVERNOR (every proposed position must pass it; PAPER only)
# ------------------------------------------------------------
# Paper bankroll (USD, notional) and limits as fractions of current equity.
# Hard ceilings in code: position 10%, exposure 60%, drawdown 25%, daily loss 10%.
JARVIS_RISK_BANKROLL=1000
JARVIS_RISK_MAX_POSITION=0.02
JARVIS_RISK_MAX_MARKET=0.04
JARVIS_RISK_MAX_STRATEGY=0.15
JARVIS_RISK_MAX_EXPOSURE=0.30
JARVIS_RISK_MAX_POSITIONS=15
# no new positions today after losing this much of the day's starting equity
JARVIS_RISK_DAILY_LOSS=0.03
# halt until the owner resumes after falling this far below peak equity
JARVIS_RISK_MAX_DRAWDOWN=0.10
JARVIS_RISK_MIN_STAKE=1
JARVIS_RISK_DB=~/friday/data/risk.db

# ------------------------------------------------------------
# PHASE 8 — PROBABILITY & EDGE
# ------------------------------------------------------------
# 8A: build the calibration dataset (resolved markets + their prices 1h..7d
# before resolution) in the background, read-only; a batch every few hours
JARVIS_CALIBRATION_BACKFILL=true
# 9B.2: minimum lifetime volume (USD) of a resolved market to enter the dataset. Raised from
# 1000: thinner markets have unreliable prices and would not pass FRIDAY's live liquidity rules.
JARVIS_CALIBRATION_MIN_VOLUME=10000
# seconds between price-history requests during the backfill
JARVIS_CALIBRATION_PACE_SECONDS=0.05
JARVIS_CALIBRATION_BATCH=300
JARVIS_CALIBRATION_INTERVAL_HOURS=3
# 8C.2 SCOPE: FRIDAY is not a sports betting system. Segments listed here are
# dropped from the scan, universe, signals, edges and the calibration backfill.
# Segments: sports, field (one outcome of a multi-candidate event), binary.
# "none" includes everything.
# 9B.2: "micro" = recurring five-minute markets ("Bitcoin Up or Down - 12:35PM-12:40PM ET").
JARVIS_EXCLUDED_SEGMENTS=sports,micro
# 8B: fair value + edge vs the live ask (estimated, unvalidated; numbers only)
JARVIS_EDGE_FEE=0.0
JARVIS_EDGE_MIN=0.02
JARVIS_EDGE_MIN_Z=2.0
JARVIS_EDGE_KELLY_FRACTION=0.25
JARVIS_EDGE_MAX_STAKE=0.02
# 8C: model-uncertainty floor ($/share) added to the edge's standard error, so
# a thick calibration bin cannot make an edge look near-certain (z 17 -> ~5)
JARVIS_EDGE_MODEL_SE=0.01
# 8C: EDGE estimates are recorded as CALIBRATION_EDGE signals (once per market)
# and scored held to resolution; it is part of JARVIS_QUANT_STRATEGIES=all

# PHASE 12 — PAPER TRADING ENGINE (paper money only; live trading stays locked)
# An entry needs one of FRIDAY's own recorded quotes this fresh, and a spread no wider than this.
JARVIS_PAPER_MAX_QUOTE_AGE_MINUTES=15
JARVIS_PAPER_MAX_SPREAD=0.05
# 12B forward test: the Bollinger fade placed as resting paper orders (false = off; it is then not listed in the gate)
JARVIS_PAPER_BOLLINGER=true
# 13B SETTLEMENT: close a position this many minutes before its market's end date rather than holding
# into resolution, where the book thins and the spread widens. 0 = hold to resolution.
JARVIS_PAPER_SETTLE_BEFORE_MINUTES=30
# ...unless the bid is already this high, where selling costs more spread than holding could gain.
# "none" = always exit. /api/paper reports whether exiting early actually helped.
JARVIS_PAPER_SETTLE_HOLD_ABOVE=0.97

# PHASE 14A — DEPTH-AWARE FILLS
# Before 14A a paper order took any size at the best price. Ask for $500 where $40 rests and the
# engine handed you $500 at the top ask, which is money that does not exist and grows with size.
# With this on, a fill walks the order book FRIDAY recorded, level by level, and the stop and
# target hang off the price actually paid. Turn it off ONLY to reproduce a pre-14A result for
# comparison: the numbers it produces are not transferable to live trading.
JARVIS_PAPER_DEPTH_AWARE=true
# How far past the best ask an entry is willing to pay, in dollars of price. Entries behave like a
# limit order: levels beyond this band are left alone, so the fill may be partial and the position
# is cut to what rests inside the band. Exits ignore this — leaving is not optional.
JARVIS_PAPER_MAX_SLIPPAGE=0.02
# Minimum resting liquidity inside that band before a market is tradeable at all. Below it the
# order is refused rather than filled against a book too thin to show a real price.
JARVIS_PAPER_MIN_DEPTH_USD=5

# PHASE 14B — TRADING COSTS
# Polymarket charges the taker  shares * rate * price * (1 - price)  -- quadratic in price, worst
# at 0.50 and vanishing in the tails -- at a rate set by the market's category (crypto 0.07,
# politics/mentions 0.04, most others 0.05, geopolitics 0 on the published schedule). An
# unclassified market is charged the highest rate in the table, never the lowest. The fee is folded
# into the booked price, so drawdown, the scorecard and the validation gate all see net-of-fee
# numbers without any of them having to know fees exist.
#
# THESE RATES MUST BE CONFIRMED AGAINST POLYMARKET'S OWN FEE PAGE BEFORE ANY LIVE TRADE.
# The schedule has changed more than once and public sources disagree on at least one category.
JARVIS_PAPER_FEES=true
# Stress the schedule without editing it: 1.5 asks what a 50% rise would do to the record.
JARVIS_PAPER_FEE_MULTIPLIER=1.0
# 0 matches Polymarket's relayer sponsoring gas for proxy/Safe wallets. An EOA signer pays gas on
# every approval, split, merge and redemption; set this to price that assumption rather than forget it.
JARVIS_PAPER_GAS_USD=0

# PHASE 15 — MULTI-LEG ARBITRAGE (paper only)
# A two-outcome market pays exactly $1 to one side, so two asks summing to under $1 lock in the
# difference whichever way it resolves. The 9C scan has been finding these since Phase 9 and
# nothing traded them. Both legs open together or neither does; the pair is held to resolution,
# because selling early realises bid+bid, which is below $1 and hands the whole edge back.
#
# Only trades if the validation gate currently allows PRICING_INCONSISTENCY. OFF by default.
JARVIS_PAPER_ARB=false
# What one opportunity asks for. The Risk Governor decides the real size.
JARVIS_PAPER_ARB_BUDGET=50
# Minimum locked profit per pair, NET OF FEES, before an order is worth placing. The fee peaks at
# 0.50, so a balanced 0.49/0.49 pair pays ~2.5c a pair in a 0.05 category and a 2c gap there is a
# LOSS. Most surviving opportunities are lopsided pairs or zero-fee categories.
JARVIS_PAPER_ARB_MIN_LOCKED=0.005

# PHASE 13A — REAL-TIME TRIGGER (paper only; read-only public market feed, no keys, no orders)
# Off by default. When on, held positions and resting paper orders are watched live over
# wss://ws-subscriptions-clob.polymarket.com/ws/market, so stops/targets/fills happen in seconds
# instead of at the next 15-minute scan. If the feed drops, FRIDAY falls back to recorded quotes.
JARVIS_TRIGGER=false
# a watchlist token moving this much (probability points) is counted; held tokens use the PRIORITY values
JARVIS_TRIGGER_MOVE=0.02
JARVIS_TRIGGER_COOLDOWN_S=30
JARVIS_TRIGGER_PRIORITY_MOVE=0.005
JARVIS_TRIGGER_PRIORITY_COOLDOWN_S=2
# most tokens subscribed at once (held tokens are always included first)
JARVIS_TRIGGER_MAX_TOKENS=150
# 13B: the engine is also ticked on this heartbeat, so time-based exits (settlement, the time limit)
# do not wait for a price move. 0 = price moves only.
JARVIS_TRIGGER_HEARTBEAT_S=60

# 13C SIGNAL TRADING: place paper orders for the strategies the validation gate already allows
# (APPROVED_FOR_PAPER or FORWARD_TEST). Until this exists the gate could approve a strategy and
# nothing would trade it. The bet placed is the one the 7C scorecard measured: entry at the ask,
# exit at the signal's own horizon, NO stop and NO target. A stop would be a different bet.
# Off by default. Nothing trades while the gate approves nothing, whatever this is set to.
JARVIS_PAPER_SIGNALS=false
JARVIS_PAPER_SIGNAL_STAKE=20

# 13D API AUTHENTICATION. Every POST/PUT/PATCH/DELETE needs this secret; reads stay open so the
# dashboard works. Unset = no authentication, which is how the API behaved before 13D.
# This is not only about other machines: a browser sends requests to 127.0.0.1 from ANY page the
# owner has open, so a web page could otherwise POST /api/hermes/kill or /api/directives/resume
# (which restarts a platform TERMINATOR shut down). There is no localhost exemption.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Then send it as:    Authorization: Bearer <token>   or   X-JARVIS-Token: <token>
JARVIS_API_TOKEN=
